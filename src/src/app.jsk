import React, { useState, useEffect, useRef } from "react";

// --- WEB AUDIO API SOUND GENERATOR ---
class SoundManager {
  constructor() {
    this.ctx = null;
    this.enabled = true;
  }
  init() {
    if (!this.ctx) {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (AudioContext) this.ctx = new AudioContext();
    }
    if (this.ctx && this.ctx.state === "suspended") {
      this.ctx.resume();
    }
  }
  playClick() {
    if (!this.enabled) return;
    this.init();
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(600, this.ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(800, this.ctx.currentTime + 0.05);
    gain.gain.setValueAtTime(0.1, this.ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.05);
    osc.connect(gain);
    gain.connect(this.ctx.destination);
    osc.start();
    osc.stop(this.ctx.currentTime + 0.05);
  }
  playWin() {
    if (!this.enabled) return;
    this.init();
    if (!this.ctx) return;
    const now = this.ctx.currentTime;
    [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = "triangle";
      osc.frequency.setValueAtTime(freq, now + i * 0.08);
      gain.gain.setValueAtTime(0.15, now + i * 0.08);
      gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.2);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start(now + i * 0.08);
      osc.stop(now + i * 0.08 + 0.2);
    });
  }
  playCrash() {
    if (!this.enabled) return;
    this.init();
    if (!this.ctx) return;
    const now = this.ctx.currentTime;
    const bufferSize = this.ctx.sampleRate * 0.5;
    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
      data[i] = Math.random() * 2 - 1;
    }
    const noise = this.ctx.createBufferSource();
    noise.buffer = buffer;
    const filter = this.ctx.createBiquadFilter();
    filter.type = "lowpass";
    filter.frequency.setValueAtTime(300, now);
    filter.frequency.linearRampToValueAtTime(50, now + 0.5);
    const gain = this.ctx.createGain();
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
    noise.connect(filter);
    filter.connect(gain);
    gain.connect(this.ctx.destination);
    noise.start(now);
    noise.stop(now + 0.5);
  }
}

const sounds = new SoundManager();

export default function App() {
  // --- STATE ---
  const [authView, setAuthView] = useState("login"); // "login", "register", "app"
  const [currentUser, setCurrentUser] = useState(null);
  const [activeTab, setActiveTab] = useState("game"); // "game", "wallet", "admin", "profile"
  
  // DB & Storage State
  const [users, setUsers] = useState([
    { id: 1, username: "admin", pin: "1234", balance: 50000, isAdmin: true, avatar: "👑" },
    { id: 2, username: "player1", pin: "1234", balance: 0, isAdmin: false, avatar: "🚀" }
  ]);
  const [transactions, setTransactions] = useState([
    { id: 101, username: "player1", type: "Deposit", amount: 5000, status: "Successful", date: "2026-03-30 14:20" },
    { id: 102, username: "player1", type: "Withdrawal", amount: 1200, status: "Pending", date: "2026-03-30 15:45" }
  ]);
  const [gameHistory, setGameHistory] = useState([
    { id: 1, crashMultiplier: 2.45, time: "16:00" },
    { id: 2, crashMultiplier: 5.12, time: "15:58" },
    { id: 3, crashMultiplier: 1.85, time: "15:55" },
    { id: 4, crashMultiplier: 3.20, time: "15:52" },
  ]);

  // Auth form state
  const [authUsername, setAuthUsername] = useState("");
  const [authPin, setAuthPin] = useState("");
  const [authError, setAuthError] = useState("");

  // Game Engine State
  const [gameState, setGameState] = useState("waiting"); // "waiting", "running", "crashed"
  const [multiplier, setMultiplier] = useState(1.00);
  const [countdown, setCountdown] = useState(5);
  const [prevMultipliers, setPrevMultipliers] = useState([2.45, 5.12, 1.85, 3.20, 1.15]);
  const [notification, setNotification] = useState(null);
  const [soundEnabled, setSoundEnabled] = useState(true);
  const [highDetail, setHighDetail] = useState(true);

  // Slot 1 & Slot 2 State
  const [slot1, setSlot1] = useState({
    betAmount: 100,
    autoCashOut: 2.00,
    autoBet: false,
    status: "idle", // "idle", "betting", "cashed"
    cashedMultiplier: null,
    winAmount: 0
  });
  const [slot2, setSlot2] = useState({
    betAmount: 100,
    autoCashOut: 3.00,
    autoBet: false,
    status: "idle",
    cashedMultiplier: null,
    winAmount: 0
  });

  // Wallet State
  const [depositAmount, setDepositAmount] = useState(500);
  const [depositStatus, setDepositStatus] = useState("idle"); // "idle", "processing", "success"
  const [withdrawAmount, setWithdrawAmount] = useState(1000);
  const [withdrawUpi, setWithdrawUpi] = useState("");
  const [withdrawMsg, setWithdrawMsg] = useState("");

  // Refs for animation loops
  const gameLoopRef = useRef(null);
  const countdownRef = useRef(null);
  const targetCrashRef = useRef(2.00);

  // --- GAME ENGINE LOGIC ---
  useEffect(() => {
    if (gameState === "waiting") {
      setCountdown(5);
      if (countdownRef.current) clearInterval(countdownRef.current);
      countdownRef.current = setInterval(() => {
        setCountdown((prev) => {
          if (prev <= 1) {
            clearInterval(countdownRef.current);
            startNewRound();
            return 0;
          }
          return prev - 1;
        });
      }, 1000);
    }
    return () => clearInterval(countdownRef.current);
  }, [gameState]);

  const startNewRound = () => {
    sounds.playClick();
    // Strictly crash after 2.00x: random value between 2.00 and 20.00
    targetCrashRef.current = parseFloat((2.0 + Math.random() * 18.0).toFixed(2));
    setMultiplier(1.00);
    setGameState("running");

    // Process auto-bets or queued bets
    [slot1, slot2].forEach((slot, idx) => {
      const setter = idx === 0 ? setSlot1 : setSlot2;
      if (slot.autoBet || slot.status === "betting") {
        if (currentUser && currentUser.balance >= slot.betAmount) {
          updateBalance(-slot.betAmount);
          setter(s => ({ ...s, status: "betting", cashedMultiplier: null, winAmount: 0 }));
        } else {
          setter(s => ({ ...s, status: "idle", autoBet: false }));
        }
      }
    });

    let currentMult = 1.00;
    const startTime = Date.now();

    if (gameLoopRef.current) clearInterval(gameLoopRef.current);
    gameLoopRef.current = setInterval(() => {
      const elapsed = (Date.now() - startTime) / 1000;
      // Exponential growth curve
      currentMult = parseFloat((1.00 + Math.pow(elapsed, 1.6) * 0.15).toFixed(2));

      if (currentMult >= targetCrashRef.current) {
        currentMult = targetCrashRef.current;
        setMultiplier(currentMult);
        clearInterval(gameLoopRef.current);
        triggerCrash(currentMult);
      } else {
        setMultiplier(currentMult);
        // Check auto cash outs
        checkAutoCashOut(currentMult);
      }
    }, 50);
  };

  const checkAutoCashOut = (currentMult) => {
    if (slot1.status === "betting" && slot1.autoCashOut > 1 && currentMult >= slot1.autoCashOut) {
      cashOutSlot(1, slot1.autoCashOut);
    }
    if (slot2.status === "betting" && slot2.autoCashOut > 1 && currentMult >= slot2.autoCashOut) {
      cashOutSlot(2, slot2.autoCashOut);
    }
  };

  const triggerCrash = (finalMult) => {
    sounds.playCrash();
    setGameState("crashed");
    setPrevMultipliers(prev => [finalMult, ...prev.slice(0, 7)]);
    setGameHistory(prev => [{ id: Date.now(), crashMultiplier: finalMult, time: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) }, ...prev]);

    // Handle remaining active bets as lost
    [
      { slot: slot1, setter: setSlot1, num: 1 },
      { slot: slot2, setter: setSlot2, num: 2 }
    ].forEach(({ slot, setter }) => {
      if (slot.status === "betting") {
        setter(s => ({ ...s, status: "idle" }));
        showNotification(`Slot lost: ₹${slot.betAmount} crashed at ${finalMult}x`, "error");
      }
    });

    setTimeout(() => {
      setGameState("waiting");
    }, 3000);
  };

  const cashOutSlot = (slotNum, mult) => {
    const slot = slotNum === 1 ? slot1 : slot2;
    const setter = slotNum === 1 ? setSlot1 : setSlot2;
    if (slot.status !== "betting") return;

    const win = Math.floor(slot.betAmount * mult);
    updateBalance(win);
    sounds.playWin();
    setter(s => ({ ...s, status: "cashed", cashedMultiplier: mult, winAmount: win }));
    showNotification(`Won ₹${win} (${mult}x) on Slot ${slotNum}!`, "success");
  };

  const handleManualCashOut = (slotNum) => {
    cashOutSlot(slotNum, multiplier);
  };

  const handleBetToggle = (slotNum) => {
    const slot = slotNum === 1 ? slot1 : slot2;
    const setter = slotNum === 1 ? setSlot1 : setSlot2;

    if (slot.status === "betting") {
      setter(s => ({ ...s, status: "idle", autoBet: false }));
    } else {
      if (!currentUser || currentUser.balance < slot.betAmount) {
        showNotification("Insufficient balance!", "error");
        return;
      }
      if (gameState === "waiting" || gameState === "crashed") {
        updateBalance(-slot.betAmount);
        setter(s => ({ ...s, status: "betting", cashedMultiplier: null, winAmount: 0 }));
      } else {
        // Queue for next round
        setter(s => ({ ...s, autoBet: !s.autoBet }));
        showNotification(slot.autoBet ? "Auto-bet cancelled" : "Bet placed for next round!", "info");
      }
    }
  };

  const updateBalance = (amount) => {
    if (!currentUser) return;
    const updatedBalance = currentUser.balance + amount;
    const updatedUser = { ...currentUser, balance: updatedBalance };
    setCurrentUser(updatedUser);
    setUsers(users.map(u => u.id === updatedUser.id ? updatedUser : u));
  };

  const showNotification = (msg, type) => {
    setNotification({ msg, type });
    setTimeout(() => setNotification(null), 3000);
  };

  // --- AUTH HANDLERS ---
  const handleLogin = (e) => {
    e.preventDefault();
    const found = users.find(u => u.username.toLowerCase() === authUsername.toLowerCase() && u.pin === authPin);
    if (found) {
      setCurrentUser(found);
      setAuthView("app");
      setAuthError("");
    } else {
      setAuthError("Invalid username or 4-digit PIN");
    }
  };

  const handleRegister = (e) => {
    e.preventDefault();
    if (!authUsername || authPin.length !== 4) {
      setAuthError("Please enter username and 4-digit PIN");
      return;
    }
    if (users.some(u => u.username.toLowerCase() === authUsername.toLowerCase())) {
      setAuthError("Username already exists");
      return;
    }
    const newUser = {
      id: Date.now(),
      username: authUsername,
      pin: authPin,
      balance: 0,
      isAdmin: false,
      avatar: "👤"
    };
    setUsers([...users, newUser]);
    setCurrentUser(newUser);
    setAuthView("app");
    setAuthError("");
  };

  // --- RENDER AUTH SCREENS ---
  if (authView !== "app") {
    return (
      <div className="min-h-screen bg-black text-white flex flex-col items-center justify-center p-4 font-sans select-none">
        <div className="w-full max-w-sm bg-neutral-900 border border-neutral-800 rounded-2xl p-6 shadow-2xl">
          <div className="text-center mb-6">
            <h1 className="text-3xl font-black tracking-wider text-red-600 italic">AEROCRASH</h1>
            <p className="text-xs text-neutral-400 mt-1">Professional Mobile Crash Game</p>
          </div>

          {authError && (
            <div className="bg-red-950/80 border border-red-600 text-red-200 text-xs p-3 rounded-lg mb-4 text-center">
              {authError}
            </div>
          )}

          <form onSubmit={authView === "login" ? handleLogin : handleRegister} className="space-y-4">
            <div>
              <label className="block text-xs font-semibold text-neutral-400 mb-1 uppercase tracking-wider">Username</label>
              <input
                type="text"
                value={authUsername}
                onChange={(e) => setAuthUsername(e.target.value)}
                placeholder="Enter username"
                className="w-full bg-neutral-800 border border-neutral-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-red-600"
                required
              />
            </div>
            <div>
              <label className="block text-xs font-semibold text-neutral-400 mb-1 uppercase tracking-wider">4-Digit PIN</label>
              <input
                type="password"
                maxLength="4"
                value={authPin}
                onChange={(e) => setAuthPin(e.target.value)}
                placeholder="••••"
                className="w-full bg-neutral-800 border border-neutral-700 rounded-xl px-4 py-3 text-sm text-white text-center tracking-widest focus:outline-none focus:border-red-600"
                required
              />
            </div>
            <button
              type="submit"
              className="w-full bg-red-600 hover:bg-red-700 active:scale-95 transition text-white font-bold py-3.5 rounded-xl shadow-lg shadow-red-600/30 text-sm uppercase tracking-wider"
            >
              {authView === "login" ? "Login to Game" : "Create Account"}
            </button>
          </form>

          <div className="mt-6 text-center">
            {authView === "login" ? (
              <p className="text-xs text-neutral-400">
                Don't have an account?{" "}
                <button onClick={() => { setAuthView("register"); setAuthError(""); }} className="text-red-500 font-bold hover:underline">
                  Register
                </button>
              </p>
            ) : (
              <p className="text-xs text-neutral-400">
                Already have an account?{" "}
                <button onClick={() => { setAuthView("login"); setAuthError(""); }} className="text-red-500 font-bold hover:underline">
                  Login
                </button>
              </p>
            )}
          </div>
          <div className="mt-4 pt-4 border-t border-neutral-800 text-center">
            <span className="text-[10px] text-neutral-500">Quick Test Accounts: admin / 1234 or player1 / 1234</span>
          </div>
        </div>
      </div>
    );
  }

  // --- MAIN APP INTERFACE ---
  return (
    <div className="min-h-screen bg-black text-white flex flex-col max-w-md mx-auto relative overflow-hidden font-sans select-none shadow-2xl border-x border-neutral-900">
      
      {/* NOTIFICATION TOAST */}
      {notification && (
        <div className={`absolute top-4 left-4 right-4 z-50 p-3 rounded-xl text-center text-xs font-bold shadow-xl border backdrop-blur-md animate-bounce ${
          notification.type === "success" ? "bg-emerald-950/90 border-emerald-500 text-emerald-200" :
          notification.type === "error" ? "bg-red-950/90 border-red-500 text-red-200" : "bg-neutral-900/90 border-neutral-700 text-neutral-200"
        }`}>
          {notification.msg}
        </div>
      )}

      {/* TOP HEADER */}
      <header className="bg-neutral-950 border-b border-neutral-800 px-4 py-3 flex items-center justify-between sticky top-0 z-40">
        <div className="flex items-center space-x-2">
          <div className="w-8 h-8 rounded-xl bg-gradient-to-br from-red-600 to-neutral-900 flex items-center justify-center font-black text-sm text-white shadow-md">
            ✈
          </div>
          <div>
            <h1 className="font-black text-sm tracking-wider text-red-600 italic">AEROCRASH</h1>
            <p className="text-[10px] text-neutral-400">@ {currentUser.username}</p>
          </div>
        </div>

        <div className="flex items-center space-x-3">
          <div className="bg-neutral-900 border border-neutral-800 px-3 py-1.5 rounded-xl flex items-center space-x-2">
            <span className="text-emerald-500 font-bold text-xs">₹</span>
            <span className="font-black text-sm tracking-tight text-white">{currentUser.balance.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
          </div>
          <button 
            onClick={() => setSoundEnabled(!soundEnabled)}
            className="w-9 h-9 bg-neutral-900 border border-neutral-800 rounded-xl flex items-center justify-center text-xs hover:border-neutral-700 active:scale-95"
          >
            {soundEnabled ? "🔊" : "🔇"}
          </button>
        </div>
      </header>

      {/* SCROLLABLE MAIN CONTENT AREA */}
      <main className="flex-1 overflow-y-auto pb-20">
        
        {/* TAB 1: GAME ARENA */}
        {activeTab === "game" && (
          <div className="p-4 space-y-4">
            
            {/* PREVIOUS ROUND MULTIPLIERS */}
            <div className="flex items-center space-x-2 overflow-x-auto pb-1 scrollbar-none">
              <span className="text-[10px] text-neutral-500 font-bold uppercase tracking-wider shrink-0">History:</span>
              {prevMultipliers.map((m, idx) => (
                <span 
                  key={idx} 
                  className={`px-2.5 py-1 rounded-lg text-xs font-black shrink-0 border ${
                    m >= 2.0 ? "bg-emerald-950/60 border-emerald-800 text-emerald-400" : "bg-neutral-900 border-neutral-800 text-neutral-400"
                  }`}
                >
                  {m}x
                </span>
              ))}
            </div>

            {/* FLIGHT ARENA SCREEN */}
            <div className="relative w-full h-56 bg-gradient-to-b from-neutral-950 via-neutral-900 to-black border border-neutral-800 rounded-2xl overflow-hidden flex flex-col items-center justify-center shadow-inner">
              
              {/* Grid Background Lines */}
              <div className="absolute inset-0 bg-[linear-gradient(to_right,#202020_1px,transparent_1px),linear-gradient(to_bottom,#202020_1px,transparent_1px)] bg-[size:2rem_2rem] opacity-30"></div>

              {/* WAITING / COUNTDOWN STATE */}
              {gameState === "waiting" && (
                <div className="z-10 text-center space-y-1">
                  <span className="text-xs uppercase tracking-widest text-neutral-400 font-bold">Next Round Starts In</span>
                  <div className="text-5xl font-black text-red-600 tracking-tighter animate-pulse">0{countdown}s</div>
                  <p className="text-[10px] text-neutral-500">Place your bets below</p>
                </div>
              )}

              {/* RUNNING STATE */}
              {gameState === "running" && (
                <div className="z-10 text-center space-y-1 animate-fadeIn">
                  <div className="text-xs uppercase tracking-widest text-emerald-400 font-bold flex items-center justify
